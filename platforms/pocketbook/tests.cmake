find_program(KOBALT_TEST_ZIP zip REQUIRED)
add_executable(pocketbook-test "${KOBALT_ROOT}/tests/pocketbook/window_test.cpp")
target_link_libraries(pocketbook-test PRIVATE kobalt-desktop kobalt-core Qt6::Test)
target_include_directories(pocketbook-test PRIVATE "${KOBALT_ROOT}/tests/support")
target_compile_definitions(pocketbook-test PRIVATE KOBALT_ASSETS="${KOBALT_ASSETS}"
    KOBALT_FIXTURE="${KOBALT_ROOT}/tests/fixtures/trevelyans-type-tester.kepub.epub")
add_executable(pocketbook-fixtures "${KOBALT_ROOT}/tests/pocketbook/fixtures.cpp")
target_link_libraries(pocketbook-fixtures PRIVATE Qt6::Core z)
target_include_directories(pocketbook-fixtures PRIVATE "${KOBALT_ROOT}/tests/support")
target_compile_definitions(pocketbook-fixtures PRIVATE KOBALT_TEST_ZIP="${KOBALT_TEST_ZIP}")
if(NOT CMAKE_CROSSCOMPILING)
    add_test(NAME pocketbook.registration COMMAND bash "${KOBALT_ROOT}/platforms/pocketbook/test-registration.sh")
    set_tests_properties(pocketbook.registration PROPERTIES LABELS "fast;pocketbook" TIMEOUT 30)
endif()
