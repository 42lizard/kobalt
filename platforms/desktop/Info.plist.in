<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>CFBundleExecutable</key><string>Kobalt</string>
    <key>CFBundleIdentifier</key><string>@KOBALT_BUNDLE_IDENTIFIER@</string>
    <key>CFBundleName</key><string>@KOBALT_BUNDLE_NAME@</string>
    <key>CFBundleDisplayName</key><string>@KOBALT_BUNDLE_NAME@</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>@KOBALT_BUNDLE_VERSION@</string>
    <key>CFBundleVersion</key><string>@KOBALT_BUNDLE_VERSION@</string>
    <key>NSHighResolutionCapable</key><true/>
    <key>LSMinimumSystemVersion</key><string>14.0</string>
    @KOBALT_DOCUMENT_TYPES@
</dict></plist>
