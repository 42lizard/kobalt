<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>CFBundleExecutable</key><string>Kobalt</string>
    <key>CFBundleIdentifier</key><string>com.nicoverbruggen.kobalt.desktop</string>
    <key>CFBundleName</key><string>Kobalt</string>
    <key>CFBundleDisplayName</key><string>Kobalt</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>@KOBALT_BUNDLE_VERSION@</string>
    <key>CFBundleVersion</key><string>@KOBALT_BUNDLE_VERSION@</string>
    <key>NSHighResolutionCapable</key><true/>
    <key>LSMinimumSystemVersion</key><string>14.0</string>
    <key>CFBundleDocumentTypes</key><array><dict>
        <key>CFBundleTypeName</key><string>EPUB book</string>
        <key>CFBundleTypeRole</key><string>Viewer</string>
        <key>LSHandlerRank</key><string>Alternate</string>
        <key>LSItemContentTypes</key><array><string>org.idpf.epub-container</string></array>
    </dict></array>
</dict></plist>
