{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "mac",
      "displayName": "Mac development app",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../../build/desktop-mac",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "14.0"
      }
    },
    {
      "name": "linux",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../../build/desktop-linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": ""
      }
    },
    {
      "name": "pocketbook-host",
      "inherits": "linux",
      "binaryDir": "${sourceDir}/../../build/pocketbook/host-beta4",
      "cacheVariables": {
        "KOBALT_POCKETBOOK": "ON"
      }
    },
    {
      "name": "pocketbook",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../../build/pocketbook/arm-beta4",
      "toolchainFile": "${sourceDir}/../pocketbook/toolchain.cmake",
      "cacheVariables": {
        "KOBALT_POCKETBOOK": "ON",
        "CMAKE_BUILD_TYPE": "Release",
        "KOBALT_FIRMWARE_LIBS": "${sourceDir}/../../build/pocketbook/firmware/runtime/lib",
        "PNG_LIBRARY": "/usr/lib/arm-linux-gnueabi/libpng16.a",
        "PNG_PNG_INCLUDE_DIR": "/usr/include/libpng16",
        "ZLIB_LIBRARY": "/usr/lib/arm-linux-gnueabi/libz.a",
        "ZLIB_INCLUDE_DIR": "/usr/include"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "mac",
      "configurePreset": "mac",
      "targets": [
        "Kobalt"
      ],
      "jobs": 2
    },
    {
      "name": "mac-tests",
      "configurePreset": "mac",
      "targets": [
        "kobalt-tests"
      ],
      "jobs": 2
    },
    {
      "name": "mac-fast-tests",
      "configurePreset": "mac",
      "targets": [
        "kobalt-fast-tests"
      ],
      "jobs": 2
    },
    {
      "name": "mac-screenshots",
      "configurePreset": "mac",
      "targets": [
        "screenshots"
      ],
      "jobs": 2
    },
    {
      "name": "linux",
      "configurePreset": "linux",
      "targets": [
        "Kobalt"
      ],
      "jobs": 4
    },
    {
      "name": "linux-tests",
      "configurePreset": "linux",
      "targets": [
        "kobalt-tests"
      ],
      "jobs": 4
    },
    {
      "name": "pocketbook-host",
      "configurePreset": "pocketbook-host",
      "targets": [
        "Kobalt"
      ],
      "jobs": 4
    },
    {
      "name": "pocketbook-host-tests",
      "configurePreset": "pocketbook-host",
      "targets": [
        "pocketbook-test",
        "kobalt-profile-storage-tests",
        "kobalt-annotation-database-tests"
      ],
      "jobs": 4
    },
    {
      "name": "pocketbook",
      "configurePreset": "pocketbook",
      "targets": [
        "Kobalt"
      ],
      "jobs": 4
    },
    {
      "name": "pocketbook-tests",
      "configurePreset": "pocketbook",
      "targets": [
        "pocketbook-test",
        "kobalt-profile-storage-tests",
        "kobalt-annotation-database-tests"
      ],
      "jobs": 4
    },
    {
      "name": "linux-screenshots",
      "configurePreset": "linux",
      "targets": [
        "screenshots"
      ],
      "jobs": 4
    }
  ],
  "testPresets": [
    {
      "name": "mac",
      "configurePreset": "mac",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 2,
        "noTestsAction": "error"
      }
    },
    {
      "name": "mac-fast",
      "inherits": "mac",
      "filter": {
        "include": {
          "label": "fast"
        }
      }
    },
    {
      "name": "mac-integration",
      "inherits": "mac",
      "filter": {
        "include": {
          "label": "integration"
        }
      }
    },
    {
      "name": "linux",
      "configurePreset": "linux",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 2,
        "noTestsAction": "error"
      }
    },
    {
      "name": "pocketbook-host",
      "configurePreset": "pocketbook-host",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 2,
        "noTestsAction": "error"
      }
    },
    {
      "name": "pocketbook",
      "configurePreset": "pocketbook",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 2,
        "noTestsAction": "error"
      }
    }
  ]
}
