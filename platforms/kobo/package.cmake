set(stage "${CMAKE_CURRENT_BINARY_DIR}/package-stage")
if(QT_MAJOR EQUAL 5)
    set(member "usr/local/Kobo/imageformats")
    set(installer "KoboRoot.tgz")
else()
    set(member "imageformats")
    set(installer "Kobo.tgz")
endif()
file(REMOVE_RECURSE "${stage}")
file(MAKE_DIRECTORY "${stage}/system/${member}" "${stage}/zip/.kobo" "${stage}/zip/.adds/kobalt")
file(COPY "${LIBRARY}" DESTINATION "${stage}/system/${member}")
execute_process(COMMAND "${STRIP}" "${stage}/system/${member}/libkobalt.so" RESULT_VARIABLE result)
if(result EQUAL 0)
    find_program(KOBALT_TAR NAMES tar REQUIRED)
    execute_process(COMMAND "${KOBALT_TAR}" --format=gnu --owner=0 --group=0 --numeric-owner --mode=0755
        -czf "${stage}/zip/.kobo/${installer}" "${member}/libkobalt.so"
        WORKING_DIRECTORY "${stage}/system" RESULT_VARIABLE result)
endif()
if(result EQUAL 0)
    file(COPY "${ASSETS}/" DESTINATION "${stage}/zip/.adds/kobalt/assets")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${CMAKE_CURRENT_BINARY_DIR}/Kobalt-${VERSION}-qt${QT_MAJOR}.zip"
        --format=zip .kobo .adds WORKING_DIRECTORY "${stage}/zip" RESULT_VARIABLE result)
endif()
file(REMOVE_RECURSE "${stage}")
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Kobo packaging failed: ${result}")
endif()
