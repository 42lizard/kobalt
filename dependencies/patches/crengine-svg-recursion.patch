+// External SVG images can point back to an image already being rendered.
+// Keep the source alive in each caller and stop cycles before another bitmap
+// or decoder is created. The depth bound also covers unnamed data streams.
+class SVGRenderScope {
+    static thread_local LVStream *active[16];
+    static thread_local unsigned depth;
+    bool entered;
+public:
+    SVGRenderScope(LVStream *stream) : entered(false) {
+        if (!stream || depth == 16)
+            return;
+        const lChar32 *name = stream->GetName();
+        for (unsigned i = 0; i < depth; ++i) {
+            const lChar32 *other = active[i]->GetName();
+            if (active[i] == stream || (name && *name && other && lString32(name) == lString32(other)))
+                return;
+        }
+        active[depth++] = stream;
+        entered = true;
+    }
+    ~SVGRenderScope() { if (entered) active[--depth] = NULL; }
+    bool allowed() const { return entered; }
+};
+thread_local LVStream *SVGRenderScope::active[16] = {};
+thread_local unsigned SVGRenderScope::depth = 0;
