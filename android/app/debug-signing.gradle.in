// This public key signs debug builds only. Release signing uses an external key.
android {
    signingConfigs {
        debug {
            storeFile file('@KOBALT_ROOT@/android/debug.keystore')
            storePassword 'android'
            keyAlias 'androiddebugkey'
            keyPassword 'android'
        }
    }
    buildTypes {
        debug {
            signingConfig signingConfigs.debug
        }
    }
}
