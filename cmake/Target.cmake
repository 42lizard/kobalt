# Each Qt ABI has one build; firmware support is declared in its manifest.
set(KOBALT_TARGET "qt6" CACHE STRING "Kobalt application target")
set_property(CACHE KOBALT_TARGET PROPERTY STRINGS qt6 qt5 nickel5 nickel4)
foreach(target_variable KOBALT_TARGET KOBALT_CONFIGURED_TARGET)
    if(${target_variable} STREQUAL "nickel4")
        set(${target_variable} "qt5")
    elseif(${target_variable} STREQUAL "nickel5")
        set(${target_variable} "qt6")
    endif()
endforeach()
if(NOT KOBALT_TARGET MATCHES "^qt[56]$")
    message(FATAL_ERROR "Unsupported Kobalt target: ${KOBALT_TARGET}")
endif()
if(DEFINED KOBALT_CONFIGURED_TARGET AND NOT KOBALT_CONFIGURED_TARGET STREQUAL KOBALT_TARGET)
    message(FATAL_ERROR "Use a separate build directory for each Kobalt target")
endif()
set(KOBALT_CONFIGURED_TARGET "${KOBALT_TARGET}" CACHE INTERNAL "Target owning this build directory")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${CMAKE_CURRENT_LIST_DIR}/../targets/${KOBALT_TARGET}.json")
file(READ "${CMAKE_CURRENT_LIST_DIR}/../targets/${KOBALT_TARGET}.json" KOBALT_TARGET_JSON)
foreach(field qt_major build_root hook_root system_font_directory)
    string(JSON value GET "${KOBALT_TARGET_JSON}" "${field}")
    string(TOUPPER "${field}" field_upper)
    set(KOBALT_${field_upper} "${value}")
endforeach()
set(KOBALT_DEPENDENCY_PREFIX "${KOBALT_SOURCE_ROOT}/${KOBALT_BUILD_ROOT}/deps" CACHE PATH "Prepared Kobalt dependency installation")
include("${CMAKE_CURRENT_LIST_DIR}/../src/platform/nickel/${KOBALT_TARGET}/Sources.cmake")
