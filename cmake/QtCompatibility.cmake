if(KOBALT_QT_MAJOR EQUAL 5)
    # Qt 5.2 predates the namespaced private-header target and Qt6 resource API.
    add_library(Qt5::GuiPrivate INTERFACE IMPORTED)
    set_target_properties(Qt5::GuiPrivate PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${Qt5Gui_PRIVATE_INCLUDE_DIRS};${Qt5Core_PRIVATE_INCLUDE_DIRS}"
        INTERFACE_LINK_LIBRARIES Qt5::Gui)
    function(qt_add_resources target name)
        cmake_parse_arguments(resource "" "PREFIX;BASE" "FILES" ${ARGN})
        get_filename_component(base "${resource_BASE}" ABSOLUTE)
        set(contents "<RCC><qresource prefix=\"${resource_PREFIX}\">\n")
        foreach(file IN LISTS resource_FILES)
            get_filename_component(path "${file}" ABSOLUTE)
            file(RELATIVE_PATH alias "${base}" "${path}")
            string(APPEND contents "<file alias=\"${alias}\">${path}</file>\n")
        endforeach()
        string(APPEND contents "</qresource></RCC>\n")
        set(qrc "${CMAKE_CURRENT_BINARY_DIR}/${name}.qrc")
        file(CONFIGURE OUTPUT "${qrc}" CONTENT "${contents}" @ONLY)
        qt5_add_resources(generated "${qrc}")
        target_sources(${target} PRIVATE ${generated})
    endfunction()
endif()
